CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra -std=c11 -D_POSIX_C_SOURCE=200809L
LDLIBS = -lm

# arm926ej-s has no SIMD, so the benchmark has to time scalar code: a vectorised
# host build measures the host vectoriser instead of the change, and which of
# the two kernels it manages to vectorise is arbitrary.  The switches are
# spelled differently by the two compilers this tree builds with, so probe for
# the pair rather than guessing from the compiler name.
VEC_OFF := $(shell $(CC) -fno-vectorize -fno-slp-vectorize -x c -c /dev/null \
	-o /dev/null 2>/dev/null && echo -fno-vectorize -fno-slp-vectorize || \
	echo -fno-tree-vectorize -fno-tree-slp-vectorize)
BENCH_CFLAGS ?= $(CFLAGS) $(VEC_OFF)

HEADERS = bpe.h fixed.h infer.h solvers.h solvers_subject.h pipeline.h \
	  graph.h expr.h equation.h callmask.h reltable.h matrix.h steps.h \
	  steptable.h screen.h ui.h

SOLVERS = solvers.c solvers_math.c equation.c solvers_trig.c solvers_physics.c \
	  solvers_chem.c solvers_thermo.c solvers_em.c solvers_units.c \
	  solvers_optics.c solvers_waves.c solvers_fluids.c \
	  solvers_modern.c

# Everything the typed path needs: the pipeline pulls in the tokenizer, the
# model and the expression evaluator, and matrix.c answers linear algebra
# before any of them runs.
PIPELINE = pipeline.c bpe.c fixed.c infer.c $(SOLVERS) graph.c screen.c \
	   diagram.c expr.c callmask.c matrix.c shorthand.c steps.c

all: infer_host main_device test_solvers test_parity test_bpe test_fixed \
     test_guard test_graph test_typed test_callmask test_expr test_equation \
     test_matrix test_steps test_symbolic test_series test_ode test_alt \
     test_screen test_ui test_diagram test_shorthand bench_kernel

infer_host: main_host.c infer.c $(HEADERS)
	$(CC) $(CFLAGS) -o $@ main_host.c infer.c $(LDLIBS)

main_device: main_device.c $(PIPELINE) $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ main_device.c $(PIPELINE) $(LDLIBS)

test_solvers: test_solvers.c $(SOLVERS) $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_solvers.c $(SOLVERS) $(LDLIBS)

test_steps: test_steps.c steps.c $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_steps.c steps.c
test_ode: test_ode.c expr.c $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_ode.c expr.c $(LDLIBS)

test_series: test_series.c expr.c $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_series.c expr.c $(LDLIBS)

test_symbolic: test_symbolic.c expr.c $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_symbolic.c expr.c $(LDLIBS)

test_equation: test_equation.c expr.c $(SOLVERS) $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_equation.c expr.c $(SOLVERS) $(LDLIBS)


# Generated by gen_solver_parity.py from relations/, so this target builds the
# parity table for every relation without needing Python at build time.
test_parity: test_parity.c $(SOLVERS) $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_parity.c $(SOLVERS) $(LDLIBS)

test_bpe: test_bpe.c bpe.c $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_bpe.c bpe.c

test_fixed: test_fixed.c fixed.c infer.c $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_fixed.c fixed.c infer.c $(LDLIBS)

test_guard: test_guard.c $(PIPELINE) $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_guard.c $(PIPELINE) $(LDLIBS)

test_callmask: test_callmask.c callmask.c bpe.c $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_callmask.c callmask.c bpe.c

test_graph: test_graph.c graph.c screen.c expr.c steps.c $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_graph.c graph.c screen.c expr.c steps.c $(LDLIBS)

# The font and the primitives on their own: the UI and the plotter both draw
# through them, so a clipping bug there is a bug in two screens.
test_screen: test_screen.c screen.c screen.h
	$(CC) $(CFLAGS) -I. -o $@ test_screen.c screen.c

# The screen model needs the typed path behind it: the input line answers an
# expression with no model at all, and that is asserted here rather than
# assumed.
test_ui: test_ui.c ui.c $(PIPELINE) $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_ui.c ui.c $(PIPELINE) $(LDLIBS)

test_diagram: test_diagram.c diagram.c screen.c expr.c diagram.h $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_diagram.c diagram.c screen.c expr.c $(LDLIBS)

test_shorthand: test_shorthand.c $(PIPELINE) shorthand.h $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_shorthand.c $(PIPELINE) $(LDLIBS)

test_typed: test_typed.c $(PIPELINE) $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_typed.c $(PIPELINE) $(LDLIBS)

test_alt: test_alt.c $(PIPELINE) $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_alt.c $(PIPELINE) $(LDLIBS)

test_matrix: test_matrix.c matrix.c $(SOLVERS) $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_matrix.c matrix.c $(SOLVERS) $(LDLIBS)

test_expr: test_expr.c expr.c $(HEADERS)
	$(CC) $(CFLAGS) -I. -o $@ test_expr.c expr.c $(LDLIBS)

# Host-only microbenchmark for the int8 MAC kernel. bench_kernel.c includes
# fixed.c rather than linking it, so the kernel inlines into the row loop the
# way it does on the device; it is never part of the device build, which is
# main_device.c and the sources it links.
bench_kernel: bench_kernel.c fixed.c $(HEADERS)
	$(CC) $(BENCH_CFLAGS) -I. -o $@ bench_kernel.c $(LDLIBS)

check: all
	./test_solvers
	./test_bpe
	./test_fixed ../weights.bin
	./test_guard
	./test_callmask
	./test_graph
	./test_diagram
	./test_shorthand
	./test_typed
	./test_screen
	./test_ui
	./test_expr
	./test_equation
	sh crosscheck.sh

clean:
	rm -f infer_host main_device test_solvers test_parity test_bpe test_fixed \
	      test_guard test_graph test_typed test_callmask test_expr \
	      test_equation test_alt test_screen test_ui test_diagram test_shorthand \
      bench_kernel

.PHONY: all clean check
